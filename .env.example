# ── Twilio ──────────────────────────────────────────────────────────────────
# Find these in the Twilio Console: https://console.twilio.com
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=your_auth_token_here
TWILIO_PHONE_NUMBER=+15551234000   # Must be an SMS-capable Twilio number in E.164 format

# ── Database ─────────────────────────────────────────────────────────────────
DATABASE_URL=postgres://user:password@localhost:5432/medping

# ── Redis ─────────────────────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379

# ── Server ────────────────────────────────────────────────────────────────────
PORT=3000
NODE_ENV=development

# ── Development helpers ───────────────────────────────────────────────────────
# Set to "true" to bypass Twilio signature validation (local testing only).
# Never set this in production.
SKIP_TWILIO_VALIDATION=false
