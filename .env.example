# ── Twilio ────────────────────────────────────────────────────────────────────
# Find these in the Twilio Console: https://console.twilio.com
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=your_auth_token_here
TWILIO_PHONE_NUMBER=+15551234000    # SMS-capable number in E.164 format

# ── Database ──────────────────────────────────────────────────────────────────
DATABASE_URL=postgres://user:password@localhost:5432/medping
# Set DB_SSL=true for managed cloud databases (Heroku, Railway, Render, RDS, etc.)
# You can also append ?sslmode=require to DATABASE_URL instead.
DB_SSL=false

# ── Redis ─────────────────────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379

# ── API security ──────────────────────────────────────────────────────────────
# Required in production. All REST endpoints check X-API-Key: <value>.
# In development, omitting this allows unauthenticated access with a warning.
# Generate with: openssl rand -hex 32
API_KEY=

# ── Server ────────────────────────────────────────────────────────────────────
PORT=3000
NODE_ENV=development

# ── Logging ───────────────────────────────────────────────────────────────────
# Levels: error | warn | info | debug  (default: info)
LOG_LEVEL=info

# ── Development helpers ───────────────────────────────────────────────────────
# Bypass Twilio signature validation for local testing without ngrok.
# NEVER set to true in production.
SKIP_TWILIO_VALIDATION=false
