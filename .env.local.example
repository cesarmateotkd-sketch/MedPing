# ── Local development environment ────────────────────────────────────────────
# Copy this file to .env to run the app locally with Docker Compose.
# SMS messages are logged to the console instead of being sent via Twilio.
#
#   cp .env.local.example .env
#   npm run docker:up
#
# To also seed test data (Alice + 3 medications):
#   npm run docker:seed

# ── Mock SMS (no Twilio account needed) ──────────────────────────────────────
SMS_MOCK=true
SKIP_TWILIO_VALIDATION=true

# ── Twilio (not used when SMS_MOCK=true — kept to satisfy format checks) ─────
TWILIO_ACCOUNT_SID=ACmocklocalmocklocalmocklocalmock00
TWILIO_AUTH_TOKEN=mock_auth_token_local_dev_only_0000
TWILIO_PHONE_NUMBER=+15550000000

# ── Database (matches docker-compose postgres service) ───────────────────────
DATABASE_URL=postgres://medping:medping@postgres:5432/medping

# ── Redis (matches docker-compose redis service) ─────────────────────────────
REDIS_URL=redis://redis:6379

# ── API security (leave empty to allow unauthenticated access in dev) ────────
API_KEY=

# ── Server ───────────────────────────────────────────────────────────────────
PORT=3000
NODE_ENV=development
LOG_LEVEL=info
